@model ArtGalleryFinal.Models.Artist

@{
    ViewData["Title"] = "Edit Artist Information";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <h1 class="text-center mb-4">Edit Artist Information</h1>

    <!-- Error Message -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <span>@TempData["Error"]</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Edit Artist Form -->
    <form asp-action="AdminEditArtistInfo" asp-controller="Admin" method="post">
        @Html.AntiForgeryToken()

        <input type="hidden" name="ArtistId" value="@Model.ArtistId" /> <!-- Hidden field for ArtistId -->

        <div class="mb-3">
            <label for="Name" class="form-label">Artist Name</label>
            <input type="text" class="form-control" id="Name" name="Name" value="@Model.Name" required />
        </div>
        <div class="mb-3">
            <label for="Email" class="form-label">Email Address</label>
            <input type="email" class="form-control" id="Email" name="Email" value="@Model.Email" required />
        </div>
        <div class="mb-3">
            <label for="PhoneNo" class="form-label">Phone Number</label>
            <input type="text" class="form-control" id="PhoneNo" name="PhoneNo" value="@Model.PhoneNo" required />
        </div>
        <div class="mb-3">
            <label for="Country" class="form-label">Country</label>
            <input type="text" class="form-control" id="Country" name="Country" value="@Model.Country" required />
        </div>
        <div class="mb-3">
            <label for="Address" class="form-label">Address</label>
            <input type="text" class="form-control" id="Address" name="Address" value="@Model.Address" required />
        </div>

        <button type="submit" class="btn btn-primary">
            <i class="bi bi-pencil-square"></i> Save Changes
        </button>
        <a href="@Url.Action("ManageAccounts", "Admin")" class="btn btn-secondary">
            <i class="bi bi-x-circle"></i> Cancel
        </a>
    </form>
</div>
