@model ArtGalleryFinal.Models.ManageAccountsViewModel

@{
	ViewData["Title"] = "Manage Accounts";
	Layout = "~/Pages/Shared/_Layout.cshtml"; // Use the shared layout
}

<div class="container mt-5">
	<h2 class="text-center mb-4">Manage Accounts</h2>

	<!-- Artists Section -->
	<h3>Artists</h3>
	<table class="table table-bordered">
		<thead>
			<tr>
				<th>Name</th>
				<th>Email</th>
				<th>Phone</th>
				<th>Country</th>
				<th>Address</th>
				<th>Actions</th>
			</tr>
		</thead>
		<tbody>
			@foreach (var artist in Model.Artists)
			{
				<tr>
					<td>@artist.Name</td>
					<td>@artist.Email</td>
					<td>@artist.PhoneNo</td>
					<td>@artist.Country</td>
					<td>@artist.Address</td>
					<td>

						<a href="/Admin/AdminEditArtistInfo/@artist.ArtistId" class="btn btn-primary btn-sm me-1">
							<i class="bi bi-pencil-square"></i> Edit
						</a>
						<form action="DeleteArtist/@artist.ArtistId" method="post" class="d-inline">
							<button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you want to delete this artist?');">
								<i class="bi bi-trash"></i> Delete
							</button>
						</form>

					</td>
				</tr>
			}
		</tbody>
	</table>

	<!-- Customers Section -->
	<h3 class="mt-5">Customers</h3>
	<table class="table table-bordered">
		<thead>
			<tr>
				<th>Name</th>
				<th>Email</th>
				<th>Phone</th>
				<th>Country</th>
				<th>Address</th>
				<th>Actions</th>
			</tr>
		</thead>
		<tbody>
			@foreach (var customer in Model.Customers)
			{
				<tr>
					<td>@customer.Name</td>
					<td>@customer.Email</td>
					<td>@customer.PhoneNo</td>
					<td>@customer.Country</td>
					<td>@customer.Address</td>
					<td>
						<a href="/Admin/AdminEditCustomerInfo/@customer.CustomerId" class="btn btn-primary btn-sm me-1">
							<i class="bi bi-pencil-square"></i> Edit
						</a>
						<form action="DeleteCustomer/@customer.CustomerId" method="post" class="d-inline">
							<button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you want to delete this customer?');">
								<i class="bi bi-trash"></i> Delete
							</button>
						</form>

					</td>
				</tr>
			}
		</tbody>
	</table>
</div>
