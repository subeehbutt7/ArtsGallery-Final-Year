@model IEnumerable<ArtGalleryFinal.Models.CartItemViewModel>
@{
	ViewData["Title"] = "View Cart";
	Layout = "~/Pages/Shared/_Layout.cshtml";
	var showShipmentForm = TempData["ShowShipmentForm"] as bool? ?? false;
}


<div class="container mt-5">
	<h1 class="text-center mb-4">Your Cart</h1>

	<!-- Feedback Messages Section -->
	@if (TempData["Error"] != null)
	{
			<div class="alert alert-danger text-center">
			@TempData["Error"]
			</div>
	}
	@if (TempData["Message"] != null)
	{
			<div class="alert alert-success text-center">
			@TempData["Message"]
			</div>
	}

	@if (Model.Any())
	{
			<table class="table table-bordered">
				<thead>
					<tr>
						<th>Artwork</th>
						<th>Image</th>
						<th>Quantity</th>
						<th>Price</th>
						<th>Total</th>
						<th>Action</th> <!-- Column for Remove Button -->
					</tr>
				</thead>
				<tbody>
				@foreach (var item in Model)
				{
							<tr>
								<td>@item.Title</td>
									<td>
			<img src="@item.ImageUrl" alt="Artwork Image" style="width:100px; height:auto;" />
		</td>
								<td>@item.Quantity</td>
								<td>RS @item.Price</td>
								<td>RS @item.TotalPrice</td>
								<td>
									<!-- Remove from Cart Button -->
									<form action="/Cart/RemoveFromCart/@item.ArtId" method="post">
								@Html.AntiForgeryToken()
										<button class="btn btn-success btn-sm" type="submit" onclick="">Remove</button>
									</form>
								</td>
							</tr>
				}
				</tbody>
			</table>
	}
	<!-- Place Order Button -->
	<div class="text-center mt-4">
		<form method="post" action="/Cart/ShowShipmentForm">
			@Html.AntiForgeryToken()
			<button class="btn btn-success btn-sm" type="submit">Place Order</button>
		</form>
	</div>

	<!-- Shipment Form -->
	@if (showShipmentForm)
	{
			<div id="shipmentForm" style="margin-top: 20px;">
				<h2 class="text-center mb-4">Shipment Details</h2>
				<form method="post" action="/Order/PlaceOrder">
				@Html.AntiForgeryToken()
					<div class="form-group">
						<label for="Address">Address</label>
						<input type="text" id="Address" name="Address" class="form-control" required />
					</div>
					<div class="form-group">
						<label for="Country">Country</label>
						<input type="text" id="Country" name="Country" class="form-control" required />
					</div>
					<div class="form-group">
						<label for="Email">Email</label>
						<input type="email" id="Email" name="Email" class="form-control" required />
					</div>
					<div class="form-group">
						<label for="PhoneNo">Phone Number</label>
						<input type="tel" id="PhoneNo" name="PhoneNo" class="form-control" required />
					</div>
						<div class="form-group">
		<label for="PaymentMethod">Payment Method</label>
		<select id="PaymentMethod" name="PaymentMethod" class="form-control" required>
			<option value="">-- Select Payment Method --</option>
			<option value="Jazzcash">Jazzcash</option>
			<option value="Stripe">Credit/Debit Card (Stripe)</option>
			<option value="CashOnDelivery">Cash on Delivery</option>
		</select>
	</div>

					<div class="text-center">
						<button class="btn btn-success btn-sm" type="submit">Checkout</button>
					</div>
				</form>
			</div>
	}

	else
	{
			<p class="text-center text-muted">Your cart is empty.</p>
	}
</div>