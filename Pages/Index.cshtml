@page
@model IndexModel
@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Welcome to ArtsGallery";
}

<div class="hero-section">
    <div class="hero-slide active" style="background-image: linear-gradient(rgba(0,0,0,0.2), rgba(0,0,0,0.2)), url('/images/Painting 1.jpeg');"></div>
    <div class="hero-slide active" style="background-image: linear-gradient(rgba(0,0,0,0.2), rgba(0,0,0,0.2)), url('/images/Painting 2.jpeg');"></div>
    <div class="hero-slide active" style="background-image: linear-gradient(rgba(0,0,0,0.2), rgba(0,0,0,0.2)), url('/images/Painting 3.jpeg');"></div>
    <div class="hero-slide active" style="background-image: linear-gradient(rgba(0,0,0,0.2), rgba(0,0,0,0.2)), url('/images/Painting 4.jpeg');"></div>
    <div class="hero-slide active" style="background-image: linear-gradient(rgba(0,0,0,0.2), rgba(0,0,0,0.2)), url('/images/Painting 5.jpeg');"></div>
    <div class="hero-slide active" style="background-image: linear-gradient(rgba(0,0,0,0.2), rgba(0,0,0,0.2)), url('/images/Painting 6.jpeg');"></div>
    <div class="hero-slide active" style="background-image: linear-gradient(rgba(0,0,0,0.2), rgba(0,0,0,0.2)), url('/images/Painting 7.jpeg');"></div>
    <div class="hero-slide active" style="background-image: linear-gradient(rgba(0,0,0,0.2), rgba(0,0,0,0.2)), url('/images/Painting 8.jpeg');"></div>
    
    

    <div class="container text-center">
        <h1 class="display-3 fw-bold mb-3">Discover Our Arts</h1>
        <p class="lead mb-4">Discover Curated Luxury Artworks & Decor</p>
        <a class="btn btn-primary btn-lg" asp-controller="Artwork" asp-action="Artworks">Explore Collection</a>
    </div>
</div>

<div class="container py-5 my-5">
    <div class="row gx-5 border-accent p-5">
        <div class="col-lg-6">
            <h2 class="display-6 fw-bold">Our Approach</h2>
        </div>
        <div class="col-lg-6">
            <p class="text-muted">
                We believe every home tells a story. ArtsGallery connects you with the finest emerging and established artists, offering curated collections that bring elegance, emotion, and mastery to your walls.
                From contemporary paintings to timeless sculptures, each piece is chosen for its ability to inspire.
            </p>
        </div>
    </div>
</div>

<div class="container py-5">
    <h3 class="text-center mb-5 display-6">Featured Artworks</h3>
    <div class="row g-4">
        @if (Model.LatestArtworks != null && Model.LatestArtworks.Any())
        {
            @foreach (var artwork in Model.LatestArtworks)
            {
                <div class="col-md-4">
                    <div class="gallery-card p-3 h-100 text-center">
                        <a href="@Url.Action("ArtworkDetails", "Artwork", new { id = artwork.ArtId })">
                            <img src="@artwork.ImageUrl" class="img-fluid mb-3 w-100" alt="@artwork.Title" style="height: 250px; object-fit: cover;" />
                        </a>
                        <h5 class="card-title fw-normal mt-2">@artwork.Title</h5>
                        <p class="text-muted small">@artwork.ArtName</p>
                        <p class="fw-bold">RS @artwork.Price</p>

                        <form method="post" asp-controller="Cart" asp-action="AddToCart" class="mt-3">
                            <input type="hidden" name="artId" value="@artwork.ArtId" />
                            <button class="btn btn-primary w-100" type="submit">
                                <i class="fas fa-shopping-cart me-2"></i> Add to Cart
                            </button>
                        </form>

                        @if (HttpContextAccessor.HttpContext.Session.GetString("CustomerId") == null)
                        {
                            <p class="text-muted small mt-2 mb-0">
                                <a href="@Url.Action("Login", "Account")" class="text-decoration-underline">Login</a> to purchase.
                            </p>
                        }
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <p class="text-muted">No artworks available to display.</p>
            </div>
        }
    </div>
    <div class="text-center mt-5">
        <a class="btn btn-outline-dark" asp-controller="Artwork" asp-action="Artworks">View Full Collection →</a>
    </div>
</div>

<div class="container py-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-6 text-center">
            <p class="text-muted mb-3">Sign up for our newsletter and never miss new arrivals.</p>
            <div class="input-group">
                <input type="email" class="form-control newsletter-input" placeholder="Email address" />
                <button class="btn btn-primary" type="button">Subscribe</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const slides = document.querySelectorAll('.hero-slide');

            // 🛠️ Safety Check: Only run the loop if slides actually exist on the page
            if (slides.length > 0) {
                let currentSlide = 0;
                const rotationSpeed = 2500; // Rotates every 2.5 seconds

                function rotateBackgrounds() {
                    slides[currentSlide].classList.remove('active');
                    currentSlide = (currentSlide + 1) % slides.length;
                    slides[currentSlide].classList.add('active');
                }

                setInterval(rotateBackgrounds, rotationSpeed);
            }
        });
    </script>
}